# ============================================
# Fashion AI System Configuration
# ============================================
# Copy this file to .env and update values as needed
# All values have defaults in config.py

# ============ LLM CONFIGURATION ============
LLM_TIMEOUT=30
LLM_OLLAMA_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.2
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=1

# ============ CONFIDENCE THRESHOLDS ============
# Thresholds must be between 0 and 1
CONFIDENCE_CATEGORY_THRESHOLD=0.80
CONFIDENCE_COLOR_THRESHOLD=0.65
CONFIDENCE_PATTERN_THRESHOLD=0.65

# ============ LOGGING CONFIGURATION ============
LOG_DIR=logs
LOG_LEVEL=INFO

# ============ RECOMMENDATION CONFIGURATION ============
MAX_OUTFIT_SUGGESTIONS=6

# ============ CONVERSATION CONFIGURATION ============
CONVERSATION_HISTORY_MAX=50

# ============ CACHING CONFIGURATION ============
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# ============ VISION MODEL CONFIGURATION ============
VISION_MODEL_TIMEOUT=60
MAX_IMAGE_SIZE_MB=10

# ============ ERROR HANDLING ============
# Set to true for detailed error messages (not recommended for production)
ENABLE_DETAILED_ERRORS=false

# ============ FEATURE FLAGS ============
ENABLE_FUZZY_MATCHING=true
FUZZY_MATCH_THRESHOLD=80
